# ─────────────────────────────────────────────────────────────
# THE FORGE — Environment Variables Example
# Copy to .env and fill in your actual values
# ─────────────────────────────────────────────────────────────

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AI Provider Configuration
# OpenRouter API Key (required for AI evaluation)
EXPO_PUBLIC_OPENROUTER_API_KEY=your-openrouter-api-key-here

# AI Model Selection (defaults to openai/gpt-oss-20b:free)
# Free models: openai/gpt-oss-20b:free, meta-llama/llama-3.2-3b-instruct:free
# Paid models: anthropic/claude-3.5-sonnet, google/gemini-pro-1.5, etc.
EXPO_PUBLIC_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free